# Docker 环境变量配置示例
# 复制此文件为 .env.docker 并修改配置

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# Session 密钥 (生产环境请使用随机字符串)
SECRET_KEY=your-random-secret-key-change-this

# Gitea Token (可选，用于推送技能到 Gitea)
# 在 Gitea 创建后，访问 http://localhost:3000/user/settings/applications 生成
GITEA_TOKEN=

# 数据库配置 (Docker 内部使用，通常不需要修改)
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=root
# DB_DATABASE=skills123

# Gitea 配置 (Docker 内部使用，通常不需要修改)
# GITEA_REPO_URL=http://gitea:3000/admin/skills__hub.git
# GITEA_PUSH_INTERVAL=30
